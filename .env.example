# Run npm run setup to create .env with random local credentials.
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
DATABASE_URL=postgresql://blueprint_app:REPLACE_APP_PASSWORD@localhost:5432/blueprint
MIGRATION_DATABASE_URL=postgresql://blueprint:REPLACE_ME@localhost:5432/blueprint
APP_DATABASE_USER=blueprint_app
APP_DATABASE_PASSWORD=REPLACE_APP_PASSWORD
POSTGRES_USER=blueprint
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=blueprint
OWNER_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AGENT_TOKEN=REPLACE_WITH_A_DIFFERENT_RANDOM_VALUE
CORS_ORIGINS=http://localhost:5173
# Exact HTTPS origins only. Leave empty to disable iframe previews.
PREVIEW_ORIGINS=
SWAGGER_ENABLED=true
# For compose.production.yml, set a domain you own, e.g. portfolio.example.com
SITE_ADDRESS=localhost
